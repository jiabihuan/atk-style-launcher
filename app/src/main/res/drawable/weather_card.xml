<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#AA9EC4E0"
                android:centerColor="#7080A8C0"
                android:endColor="#40405068"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="135"
                android:startColor="#9094B8D4"
                android:centerColor="#607090B0"
                android:endColor="#38384860"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
</selector>
